#!/bin/sh
# Pause guest1 for a bounded interval and restore this instance on exit.
set -eu

tool_dir=$(CDPATH='' cd "$(dirname "$0")" && pwd)
. "$tool_dir/guest1-common.sh"

[ "$#" -le 1 ] || { printf 'Usage: %s [seconds: 1..30]\n' "$0" >&2; exit 2; }
duration=${1:-3}
case "$duration" in
    ''|*[!0-9]*) guest1_error 'duration must be an integer from 1 to 30'; exit 2 ;;
esac
[ "${#duration}" -le 2 ] && [ "$duration" -ge 1 ] && [ "$duration" -le 30 ] || {
    guest1_error 'duration must be an integer from 1 to 30'
    exit 2
}

guest1_require_root
guest1_lock
pause_requested=0
wait_pid=

finish() {
    result=$?
    trap - 0 HUP INT TERM
    if [ -n "$wait_pid" ]; then
        kill "$wait_pid" 2>/dev/null || :
        wait "$wait_pid" 2>/dev/null || :
    fi
    if [ "$pause_requested" = 1 ]; then
        if current=$(guest1_snapshot); then
            set -- $current
            if [ "$1" = "$domain_id" ] && [ "$2" = "$domain_uuid" ]; then
                case "$3" in
                    ??p???)
                        if xl unpause "$domain_id"; then
                            printf 'Resumed guest1 (domain %s).\n' "$domain_id"
                        else
                            guest1_error 'unpause failed; inspect guest1 and recover manually'
                            [ "$result" -ne 0 ] || result=1
                        fi
                        ;;
                esac
            else
                guest1_error 'domain identity changed; refusing to unpause a replacement'
                [ "$result" -ne 0 ] || result=1
            fi
        else
            guest1_error 'cannot verify guest1 during cleanup; inspect it manually'
            [ "$result" -ne 0 ] || result=1
        fi
    fi
    guest1_unlock || { [ "$result" -ne 0 ] || result=1; }
    exit "$result"
}

trap finish 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

snapshot=$(guest1_snapshot) || {
    guest1_error 'guest1 must already be running'
    exit 1
}
set -- $snapshot
domain_id=$1
domain_uuid=$2
case "$3" in
    ??p???|???s??|?????d)
        guest1_error 'guest1 is already paused, shutting down, or dying; no change made'
        exit 1
        ;;
esac

# Recheck both the identity and state just before the mutation. Other domain
# managers must remain idle: a CLI check and mutation cannot be made atomic.
current=$(guest1_snapshot) || exit 1
[ "$current" = "$snapshot" ] || {
    guest1_error 'guest1 changed before pause; no change made'
    exit 1
}
# Arm cleanup before xl runs, including interruption or an ambiguous xl error.
pause_requested=1
xl pause "$domain_id"
printf 'Paused guest1 (domain %s) for %s seconds; Dom0 remains usable.\n' "$domain_id" "$duration"
sleep "$duration" &
wait_pid=$!
wait "$wait_pid"
wait_pid=
