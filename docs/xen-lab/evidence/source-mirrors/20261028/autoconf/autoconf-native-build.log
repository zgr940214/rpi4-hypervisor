  && sed -e 's|@wrap_program[@]|ifnames|g' -e 's|@abs_top_srcdir[@]|/src|g' -e 's|@abs_top_builddir[@]|/build|g' -e "s|@configure_input[@]|Generated from $input.|g" tests/wrapper.in >tests/ifnames.tmp
chmod +x tests/ifnames.tmp
chmod a-w tests/ifnames.tmp
mv -f tests/ifnames.tmp tests/ifnames
